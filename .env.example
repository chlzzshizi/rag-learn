# 复制此文件为 .env，填入你自己的 key
# .env 已在 .gitignore 里，不会被提交

# DeepSeek（负责"生成"那一端）
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 实测这个 key 只能调两个模型：deepseek-flash / deepseek-v4-pro。
# 注意：DeepSeek 公开文档里的 deepseek-chat / deepseek-reasoner 在这里不存在，
# 请求 deepseek-chat 会被路由到 deepseek-flash。别照抄文档。
# 用 c.models.list() 可以自己列一遍。
DEEPSEEK_MODEL=deepseek-flash

# 本地 embedding 模型（负责"检索"那一端）
# 模型不在 HuggingFace 缓存里，而是已经下到项目的 models/ 目录（见 README「网络」一节）。
# 这里写相对项目根的路径；.env 里请改成绝对路径，免得换工作目录就找不到。
EMBEDDING_MODEL=./models/Qwen3-Embedding-0.6B

# 模型加载精度：float 而不是默认的 bfloat16。
# 默认 bfloat16 时归一化后范数在 0.998~1.002 之间飘，float 下稳定在 1e-7。
# README 有实测数据。
EMBEDDING_DTYPE=float32
