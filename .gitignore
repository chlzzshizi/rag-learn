# ---------- 密钥（绝对不能提交）----------
.env

# ---------- Python 环境 ----------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ---------- 索引产物（可重建，不入库）----------
# 这些是跑 embedding 生成的，重建要花时间，但体积大且是二进制的
data/*.npy
data/*.jsonl
data/*.faiss
data/manifest.json

# ---------- 模型缓存 ----------
# 默认下载到 ~/.cache/huggingface，万一改到项目内要忽略掉
models/
.cache/

# ---------- IDE ----------
.idea/
.vscode/

# ---------- 系统 ----------
Thumbs.db
.DS_Store
desktop.ini
